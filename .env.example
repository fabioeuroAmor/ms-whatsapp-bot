# ==============================================================================
# ms-whatsapp-bot — variaveis de ambiente por profile (dev / hom / prd)
# Copie para .env e preencha com valores reais. NUNCA commitar o .env real.
# ==============================================================================

# ------------------------------------------------------------------------------
# DEV — redis/evolution/urls internas sao valores fixos em application-dev.yaml.
# sistema.email/senha ja usam ${VAR:default} de forma consistente com hom/prd.
# Para os demais, o nome via relaxed binding leva o prefixo BOT_ (nao existe
# em hom/prd, que usam nomes mais curtos - ver observacao abaixo).
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
BOT_EVOLUTION_BASE_URL=http://localhost:8090
BOT_EVOLUTION_API_KEY=sgsm-evolution-key
BOT_EVOLUTION_WEBHOOK_SECRET=sgsm-webhook-secret-dev
BOT_SGSM_IA_BASE_URL=http://localhost:8082
BOT_SGSM_BASE_URL=http://localhost:8080
BOT_AUTH_BASE_URL=http://localhost:8081
BOT_SISTEMA_EMAIL=bot-sistema@sgsm.local
BOT_SISTEMA_SENHA=vSvQsFyLherQirGkx50b!
TRACING_SAMPLING_PROBABILITY=1.0
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# ------------------------------------------------------------------------------
# HOM — application-hom.yaml ja usa ${VAR} em todos os campos abaixo (nomes
# diferentes dos usados em dev para os mesmos valores - ver nota acima).
# ------------------------------------------------------------------------------
# REDIS_HOST=
# REDIS_PORT=6379
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_WEBHOOK_SECRET=
# SGSM_IA_URL=
# SGSM_URL=
# AUTH_URL=
# BOT_SISTEMA_EMAIL=
# BOT_SISTEMA_SENHA=
# TRACING_SAMPLING_PROBABILITY=1.0
# ZIPKIN_ENDPOINT=

# ------------------------------------------------------------------------------
# PRD — mesmas variaveis de HOM (nomes identicos), valores de producao.
# Gerar segredos NOVOS - nunca reaproveitar valor de dev/hom.
# ------------------------------------------------------------------------------
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_SSL=false
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_WEBHOOK_SECRET=
# SGSM_IA_URL=
# SGSM_URL=
# AUTH_URL=
# BOT_SISTEMA_EMAIL=
# BOT_SISTEMA_SENHA=
# TRACING_SAMPLING_PROBABILITY=0.1
# ZIPKIN_ENDPOINT=
